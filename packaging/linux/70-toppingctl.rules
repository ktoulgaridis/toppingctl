# TOPPING E2x2 (USB 152a:8752): let toppingctl open its HID interface without root.
#
# TAG+="uaccess" makes systemd-logind grant access to the user logged in at the
# local seat only, via an ACL on /dev/hidrawN. No MODE or GROUP is set: the device
# never becomes world-writable and no group is granted access.
# The 70- prefix matters: uaccess tags must be applied before 73-seat-late.rules.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="152a", ATTRS{idProduct}=="8752", TAG+="uaccess"
